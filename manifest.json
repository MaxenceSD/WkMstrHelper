{
  "manifest_version": 3,
  "name": "WkMstr Helper",
  "version": "1.0.0",
  "description": "Helper pour le site Wiki-Masters",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "icons": {
    "16": "assets/icons/logo.png",
    "48": "assets/icons/logo.png",
    "128": "assets/icons/logo.png"
  },
  "action": {
    "default_title": "Clic automatique",
    "default_popup": "ui/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.wiki-masters.com/*",
        "https://wiki-masters.com/*"
      ],
      "js": [
        "features/auction-filters/market-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.wiki-masters.com/*",
        "https://wiki-masters.com/*"
      ],
      "css": [
        "features/auction-filters/content.css",
        "features/quick-market/content.css",
        "features/quick-market/modal.css",
        "features/quick-auction/content.css"
      ],
      "js": [
        "features/pack-opener/content.js",
        "features/auction-filters/core.js",
        "features/auction-filters/panel.js",
        "features/auction-filters/content.js",
        "features/quick-buyer/content.js",
        "features/quick-market/storage.js",
        "features/quick-market/api.js",
        "features/quick-market/modal.js",
        "features/quick-market/content.js",
        "features/quick-auction/api.js",
        "features/quick-auction/content.js",
        "features/collection-auction/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}